# /etc/hangar/ardusub.params: what hangar ardusub-setup sets and hangar check verifies
# (docs/10 "ArduSub's parameters", docs/12 "hangar ardusub-setup"). One NAME value per
# line. The joystick gains pinned to 1, every button function none, the failsafes
# hangar relies on, the ground station's id. Names as ArduSub 4.7 spells them: on
# 4.1 (the BlueROV2's usual firmware) MAV_GCS_SYSID is SYSID_MYGCS and BATT_FS_LOW_ACT
# is FS_BATT_ENABLE; a name the firmware does not know is never answered, and
# hangar check then reports the parameters as not read.
MAV_GCS_SYSID 255
JS_GAIN_DEFAULT 1
JS_GAIN_MAX 1
JS_GAIN_MIN 1
JS_GAIN_STEPS 1
FS_GCS_ENABLE 1
FS_LEAK_ENABLE 1
BATT_FS_LOW_ACT 1
BTN0_FUNCTION 0
BTN1_FUNCTION 0
BTN2_FUNCTION 0
BTN3_FUNCTION 0
BTN4_FUNCTION 0
BTN5_FUNCTION 0
BTN6_FUNCTION 0
BTN7_FUNCTION 0
BTN8_FUNCTION 0
BTN9_FUNCTION 0
BTN10_FUNCTION 0
BTN11_FUNCTION 0
BTN12_FUNCTION 0
BTN13_FUNCTION 0
BTN14_FUNCTION 0
# ArduSub refuses to arm unless some button is disarm (4) or arm_toggle (2)
# (AP_Arming_Sub::pre_arm_checks: "Must assign a disarm or arm_toggle button").
# Hangar sends every button as 0, so this one is never pressed; it only satisfies
# the check.
BTN15_FUNCTION 4
BTN0_SFUNCTION 0
BTN1_SFUNCTION 0
BTN2_SFUNCTION 0
BTN3_SFUNCTION 0
BTN4_SFUNCTION 0
BTN5_SFUNCTION 0
BTN6_SFUNCTION 0
BTN7_SFUNCTION 0
BTN8_SFUNCTION 0
BTN9_SFUNCTION 0
BTN10_SFUNCTION 0
BTN11_SFUNCTION 0
BTN12_SFUNCTION 0
BTN13_SFUNCTION 0
BTN14_SFUNCTION 0
BTN15_SFUNCTION 0
