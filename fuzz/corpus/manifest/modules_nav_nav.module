# /usr/share/hangar/modules/nav.module: the vehicle's state estimate, nav.state
# (modules/nav/README.md). nav.depth is its input; nav.attitude and nav.imu are
# sources, referenced on a tick only when used, so a stale IMU the filter does
# without does not flag nav.state, and a stale depth does.
[Module]
Description=Vehicle state: depth, vertical velocity, attitude
Exec=/usr/lib/hangar/hangar-nav

[Subscribe nav.depth]
[Subscribe nav.attitude]
[Subscribe nav.imu]

[Publish nav.state]
Type=nav_state
Rate=50
Inputs=nav.depth
Sources=nav.attitude nav.imu

[Params]
Type=nav_params
Allow=topside:pilot_console admin topside:admin
