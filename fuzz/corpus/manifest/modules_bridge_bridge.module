# /usr/share/hangar/modules/bridge.module: the tether bridge (docs/08-bridge.md,
# modules/bridge/README.md), on both machines. Enable it by symlinking into
# /etc/hangar/modules/ on each side; /etc/hangar/bridge.conf (BridgeConf in
# hangard.conf) is the same file on both, /etc/hangar/bridge.key the same
# 32 bytes. What it sends, receives and calls comes from bridge.conf: the
# manager derives its wiring from it.
[Module]
Description=The tether bridge: topics and calls between the vehicle and the topside
Exec=/usr/lib/hangar/hangar-bridge /etc/hangar/bridge.conf
User=hg-bridge

[Bridge]

# Files across the tether (docs/08 "Files"): never called from the other side.
# Which callers may send to which destination is [Files <dest>] Allow= in
# bridge.conf; this list is who may ask at all.
[Serve send]
Request=bridge_send_req
Reply=bridge_send_rep
Allow=* admin

[Health]
Watchdog=2s
