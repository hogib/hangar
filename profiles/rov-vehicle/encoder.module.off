# profiles/rov-vehicle/encoder.module.off: the encoder (docs/11-electric-eye.md
# "encoder", modules/encoder/README.md): the camera's own H.264 to the topside
# over RTP, nothing encoded on the vehicle. Opt-in: tools/rov/rov.sh lays it
# out as encoder.module with ENCODER=1. Its settings: encoder.conf beside it.
[Module]
Description=Video to the topside: the camera's own H.264 over RTP
Exec=/usr/lib/hangar/hangar-encoder /etc/hangar/encoder.conf
User=hg-encoder
# The camera's device belongs to the video group.
SupplementaryGroups=video

# One message per frame sent (msg/video_index.msg): an event topic, since its
# rate is the camera's. 64 slots: two seconds at 30 frames/s for the recorder.
[Publish video.index]
Type=video_index
Slots=64
# The camera's controls (msg/encoder_params.msg): exposure, gain, white balance and the
# image adjustments, set live and applied again at every start. The pilot's console may
# set them, from either side of the tether.
[Params]
Type=encoder_params
Allow=topside:pilot_console pilot_console admin topside:admin

# video.index has no rate of its own, so the watchdog is what tells the manager
# of an encoder that stopped: the module reports itself alive only while frames
# are being sent. A camera that hangs is noticed after 5 s and the module
# started again; one that is unplugged ends the module itself (exit status 75).
[Health]
Watchdog=5s

# A camera that stays unplugged is tried again every 10 s for as long as it
# takes, without the manager giving up: the back-off, and a burst limit that
# those tries never reach.
[Restart]
Policy=always
Backoff=1s..10s
Burst=30/60s
