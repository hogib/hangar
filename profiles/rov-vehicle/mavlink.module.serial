# /etc/hangar/modules/mavlink.module (profiles/rov-vehicle), opt-in with mavlink.conf.serial:
# the module on the Pixhawk's USB serial, so its user is also in the group that owns
# /dev/ttyACM0 (dialout on Raspberry Pi OS and Debian; uucp on Arch). Otherwise the
# same as mavlink.module. The vehicle's MAVLink module, ArduSub's
# only peer (docs/10-mavlink.md; modules/mavlink/README.md). Enable it by
# symlinking into /etc/hangar/modules/. Its settings are in /etc/hangar/mavlink.conf.
[Module]
Description=ArduSub's MAVLink peer: manual control, arming, telemetry
Exec=/usr/lib/hangar/hangar-mavlink /etc/hangar/mavlink.conf
User=hg-mavlink
SupplementaryGroups=hg-autopilot hangar-rec dialout

# ArduSub boots on its own schedule (SITL takes tens of seconds; the Pixhawk on USB a few after its power-up): the module is
# ready only once it has heard it and published every rated output, so the
# default 5 s grace would restart it, and run its Neutral command, until then.
[Health]
StartGrace=60s

[Subscribe ctl.wrench]
[Subscribe safety.state]
# docs/10 also subscribes safety.params, bridge.vehicle.link, recorder.session and
# hangar.vehicle.modules: the tether_timeout, the link and the session wait for the
# bridge and the recorder (README, "until the bridge").

[Publish ardusub.manual_control]
Type=manual_control
Rate=50
Actuator=yes
Inputs=ctl.wrench

[Publish ardusub.state]
Type=ardusub_state
Rate=10
# Each message names the safety.state it was judged against (Armed agreement).
Inputs=safety.state

[Publish ardusub.param]
Type=ardusub_param

# The telemetry topics of docs/10 "Telemetry".
[Publish nav.attitude]
Type=attitude
Rate=50
# Relayed from ArduSub: three periods (60 ms) would make every scheduler hiccup an
# input fault for safety; half a second is the loss that matters.
StaleAfter=500ms

[Publish nav.imu]
Type=imu
Rate=50
# Relayed from ArduSub: three periods (60 ms) would make every scheduler hiccup an
# input fault for safety; half a second is the loss that matters.
StaleAfter=500ms

[Publish nav.depth]
Type=depth
Rate=50
# Relayed from ArduSub: three periods (60 ms) would make every scheduler hiccup an
# input fault for safety. On this vehicle 1.5 s, not the sim's 500 ms: ArduSub 4.5
# on the lab's Pixhawk sends no telemetry for about a second at every arm
# (2026-11-19; not its SD log, LOG_DISARMED 1 left it unchanged), and safety's
# input trigger then fired at every arm. A real depth outage takes 1.5 s to trip
# the input failsafe here.
StaleAfter=1500ms

[Publish power.battery]
Type=battery
Rate=2
StaleAfter=3s

[Publish thr.out]
Type=thruster_out
Rate=50
# Relayed from ArduSub: three periods (60 ms) would make every scheduler hiccup an
# input fault for safety; half a second is the loss that matters.
StaleAfter=500ms

[Actuator]
Command=ctl.wrench
Neutral=/usr/lib/hangar/hangar-mavlink --neutral /etc/hangar/mavlink.conf

[Serve arm]
Request=arm_req
Reply=arm_rep
Allow=safety

[Serve setup]
Request=empty
Reply=empty
Allow=admin topside:admin
