# /usr/share/hangar/modules/console.module: Dawn Patrol, the operator's page
# (modules/console/README.md; docs/names.md). Enable it by symlinking into
# /etc/hangar/modules/. The template names the topside's manager topics; a
# copy edited for the topside says hangar.topside.system and .modules (the
# binary takes the role from the wiring it is handed).
[Module]
Description=Dawn Patrol: the operator's page
Exec=/usr/lib/hangar/dawn-patrold --listen 127.0.0.1:8081 --hellion http://127.0.0.1:8080/
# --hellion: the page the Hellion tab frames, hellion_topside's "control" port
# (legacy/hellion/examples/b-topside.json, "control": "8080"). The sim demo
# runs no hellion and has the vehicle's console on that port of the same
# host, so the tab shows that page there until hellion runs on the topside.
# The start, stop, restart and reload buttons go through the control socket
# as this module's user: without hangar-admin the manager refuses them and the
# page says so. Monitoring alone needs only the hangar group every module has.
SupplementaryGroups=hangar-admin

# The manager's own topics: the system state and one message per module.
[Subscribe hangar.topside.system]
[Subscribe hangar.topside.modules]
# The topic browser opens any topic by name to decode its newest message, as
# `hangar echo` does; the glob lets the wiring allow that (docs/02, glob
# subscriptions). Nothing is waited on through it.
[Subscribe *]

# No rated output: ready by hg_ready(), alive by hg_alive() on its 1 s tick.
[Health]
Watchdog=10s
