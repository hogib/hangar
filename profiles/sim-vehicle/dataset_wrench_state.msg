# dataset wrench_state: one row per ctl.wrench message (docs/06-recorder.md, The row)
u64 anchor_seq # role=meta
u64 anchor_stamp_ns # role=meta
u8 boot_id[16] # role=meta the boot that numbered the anchor
u32 missing # role=meta bit i: part i missing
u32 flags # role=meta bit 0 reset, bit 1 masked, bit 2 late
u64 emitted_ns # role=meta when the live row's joins closed
f32 ctl.wrench.surge # role=label -1 to 1, forward positive
f32 ctl.wrench.sway # role=label -1 to 1, right positive
f32 ctl.wrench.heave # role=label -1 to 1, up positive
f32 ctl.wrench.roll # role=label -1 to 1
f32 ctl.wrench.pitch # role=label -1 to 1
f32 ctl.wrench.yaw # role=label -1 to 1, clockwise seen from above positive
u64 pilot.wrench._seq # role=input
u64 pilot.wrench._stamp_ns # role=input
u32 pilot.wrench._count # role=input
u32 pilot.wrench._flags # role=input
f32 pilot.wrench.surge # role=input -1 to 1, forward positive
f32 pilot.wrench.sway # role=input -1 to 1, right positive
f32 pilot.wrench.heave # role=input -1 to 1, up positive
f32 pilot.wrench.roll # role=input -1 to 1
f32 pilot.wrench.pitch # role=input -1 to 1
f32 pilot.wrench.yaw # role=input -1 to 1, clockwise seen from above positive
u64 nav.depth._seq # role=input
u64 nav.depth._stamp_ns # role=input
u32 nav.depth._count # role=input
u32 nav.depth._flags # role=input
f32 nav.depth.depth_m # role=input m, positive down
u64 nav.attitude._seq # role=input
u64 nav.attitude._stamp_ns # role=input
u32 nav.attitude._count # role=input
u32 nav.attitude._flags # role=input
f32 nav.attitude.roll # role=input rad
f32 nav.attitude.pitch # role=input rad
f32 nav.attitude.yaw # role=input rad, from north
f32 nav.attitude.rates[3] # role=input rad/s, body roll pitch yaw rates
u64 safety.state._seq # role=filter
u64 safety.state._stamp_ns # role=filter
u32 safety.state._count # role=filter
u32 safety.state._flags # role=filter
u8 safety.state.state # role=filter 0 disarmed, 1 armed, 2 failsafe, 3 arming
u8 safety.state.outputs_enabled # role=filter whether actuators may drive
