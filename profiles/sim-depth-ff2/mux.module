# The mux of profiles/sim-vehicle, with policy_depth_ff's wrench for
# residual:depth_ff.
[Module]
Description=Control source mux and envelope
Exec=/usr/lib/hangar/hangar-mux

[Subscribe pilot.wrench]
[Subscribe ctl.depth_hold]
[Subscribe nav.depth]
[Subscribe safety.state]
[Subscribe policy.depth_ff.wrench]
[Subscribe policy.depth_ff.active]

[Publish ctl.wrench]
Type=wrench
Rate=50
Sources=pilot.wrench ctl.depth_hold policy.depth_ff.wrench nav.depth

[Publish mux.state]
Type=mux_state
Rate=10

[Params]
Type=mux_params
Allow=topside:pilot_console admin topside:admin

[Serve set_mode]
Request=set_mode_req
Reply=set_mode_rep
Allow=topside:pilot_console topside:console admin topside:admin

[Restart]
OnGiveUp=failsafe
