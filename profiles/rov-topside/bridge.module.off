# profiles/rov-topside/bridge.module.off: the tether bridge, opt-in (BRIDGE=1 rov.sh up on the Pi,
# BRIDGE=1 rov.sh topside up on the laptop; tools/rov/README.md "The topside on the
# laptop"). Its settings: bridge.conf beside it.
[Module]
Description=The tether bridge: topics and calls between the vehicle and the topside
Exec=/usr/lib/hangar/hangar-bridge /etc/hangar/bridge.conf
User=hg-bridge

[Bridge]

[Health]
Watchdog=2s
