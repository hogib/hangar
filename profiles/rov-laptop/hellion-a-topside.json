{
  "name": "topside",
  "role": "topside",
  "placement": "a",
  "control": "@CONTROL_PORT@",
  "peer": "auto",
  "camera_controls": "peer",
  "preview": "pilot",
  "eeye_config": "@EEYE_CONFIG@",
  "pipelines": [
    {"name": "camera-in", "source": "rtp:5610",
     "width": 1280, "height": 720,
     "sinks": ["bus:camera"]},
    {"name": "pilot-out", "source": "bus:pilot", "framerate": 30,
     "sinks": ["rtp:127.0.0.1:5600"]}
  ]
}
