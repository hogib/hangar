# sim_vehicle without ArduSub (docs/14-simulation.md "sim_vehicle", phase 2;
# modules/sim_vehicle/README.md): opt-in. Rename to sim_vehicle.module to use it,
# and take mavlink.module out of the same root first: here the simulator writes
# nav.imu, nav.attitude, nav.depth and power.battery itself, and one topic has
# one writer. It reads thr.cmd, which this profile's thrusters module
# (thrusters.module) publishes from ctl.wrench through the actuator gate.
# For the learning loop's experiments without Docker: buoyancy and payload
# change live (hangar param set sim_vehicle buoyancy=... payload_mass=...).
[Module]
Description=Vehicle simulator, standalone
Exec=/usr/lib/hangar/hangar-sim-vehicle --seed 1

[Subscribe thr.cmd]

[Publish sim.pose]
Type=sim_pose
Rate=200

[Publish sim.velocity]
Type=sim_velocity
Rate=200

[Publish sim.thrust]
Type=sim_thrust_truth
Rate=200
Inputs=thr.cmd

[Publish nav.imu]
Type=imu
Rate=200
StaleAfter=500ms

[Publish nav.attitude]
Type=attitude
Rate=50
StaleAfter=500ms

[Publish nav.depth]
Type=depth
Rate=50
StaleAfter=500ms

[Publish power.battery]
Type=battery
Rate=1
StaleAfter=3s

[Params]
Type=sim_vehicle_params
Allow=admin topside:admin topside:pilot_console
