{
  "title": "Transport on equal terms: every system's node pair through the same cells",
  "repetitions": 10,
  "seconds": 20,
  "max_seconds": 120,
  "target_samples": 100000,
  "warmup_s": 2,
  "max_temp_c": 60,
  "cool_wait_s": 600,
  "hot_c": 80,
  "busy_pct": 25,
  "retries": 2,
  "check_all": false,
  "cores": {"pub": -1, "sub": [-2], "comment": "the two highest allowed CPUs; with more subscribers than sub CPUs they share them in turn; helpers and this script on the rest"},
  "conditions": {
    "quiet": {},
    "load2": {"spinners": 2},
    "realtime": {"realtime": {"policy": "fifo", "priority": 50}}
  },
  "sweeps": [
    {"name": "size", "size": [32, 256, 4096, 65536, 1048576], "rate": [100], "subscribers": [1], "condition": ["quiet"]},
    {"name": "rate", "size": [256], "rate": [10, 100, 1000, 10000], "subscribers": [1], "condition": ["quiet"]},
    {"name": "fan-out", "size": [256], "rate": [1000], "subscribers": [1, 2, 4, 8], "condition": ["quiet"]},
    {"name": "frames", "size": [1048576], "rate": [30], "subscribers": [1], "condition": ["quiet"]},
    {"name": "conditions", "size": [256], "rate": [1000], "subscribers": [1], "condition": ["quiet", "load2", "realtime"]},
    {"name": "start-up", "cell": "startup", "size": [256], "rate": [1000], "condition": ["quiet"]}
  ]
}
